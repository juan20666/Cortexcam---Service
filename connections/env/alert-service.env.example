# ===== alert-service ===== (copia a .env; NUNCA lo subas a git)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# --- No sensibles
DB_URL=jdbc:postgresql://postgres:5432/alert_db
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
OIDC_ISSUER_URI=http://keycloak:8080/realms/cortexcam
ALERT_COOLDOWN_SECONDS=10
ALERT_CONFIRMATION_HITS=3
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Sensibles (en prod NO van aquí: Docker secrets o Vault)
DB_USER=alert_svc
DB_PASSWORD=change-me
KAFKA_SASL_USERNAME=alert-service
KAFKA_SASL_PASSWORD=change-me
OIDC_CLIENT_SECRET=change-me
